# Environment Variables Template

# Port configuration (automatically injected by Render in production)
PORT=7860

# Model reasoning mode: 'auto' | 'openai' | 'gemini' | 'local'
# If no API keys are provided, 'auto' falls back to high-accuracy local AST engine with zero cost.
AGENT_MODE=auto

# Optional: External LLM Provider API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
